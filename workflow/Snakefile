rule all:
    input:
        [f"{pgenome(i)}/phasing.tsv" for i in INDIVIDUALS],
        [f"{OUTDIR}/{s}/fastqc" for s in SAMPLES] if config["fastqc"] else [],
        expand(
            f"{OUTDIR}/{{unit}}/{{level}}/{{unit}}.{{test}}.significant.tsv",
            unit=UNITS,
            level=["snvs", "genes"],
            test=["binomial", "betabinomial"],
        ),
        expand(
            f"{OUTDIR}/{{unit}}/genes/{{unit}}.{{test}}.significant.named.tsv",
            unit=UNITS,
            test=["binomial", "betabinomial"],
        ),
        expand(
            f"{OUTDIR}/{{unit}}/{{level}}/{{unit}}.allelic_ratio.{{stage}}.svg",
            unit=UNITS,
            level=["snvs", "genes"],
            stage=["raw", "filtered", "testable"],
        ),
